{
  "permissions": {
    "deny": [
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/.env.development)",
      "Read(/.env.development.local)",
      "Read(/.env.test)",
      "Read(/.env.test.local)",
      "Read(/.env.staging)",
      "Read(/.env.staging.local)",
      "Read(/.env.production)",
      "Read(/.env.production.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(/secrets/**)",
      "Read(**/secrets/**)",
      "Read(/credentials/**)",
      "Read(**/credentials/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)"
    ]
  }
}
